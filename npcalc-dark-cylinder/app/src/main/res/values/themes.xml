<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
	<style name="Theme.NpcalcDark" parent="Theme.Material3.Dark.NoActionBar">
		<item name="android:statusBarColor">@color/npcolor_background_main</item>
		<item name="android:navigationBarColor">@color/npcolor_background_main</item>
		<item name="colorPrimary">@color/npcolor_accent</item>
		<item name="colorSecondary">@color/npcolor_accent</item>
		<item name="android:windowBackground">@color/npcolor_background_main</item>
		<item name="materialButtonStyle">@style/NpcalcPillButtonStyle</item>
		<item name="toolbarStyle">@style/NpcalcToolbarStyle</item>
	</style>

	<style name="NpcalcPillButtonStyle" parent="Widget.Material3.Button">
		<item name="android:minHeight">64dp</item>
		<item name="android:minWidth">64dp</item>
		<item name="android:insetTop">0dp</item>
		<item name="android:insetBottom">0dp</item>
		<item name="android:textColor">@color/npcolor_text_primary</item>
		<item name="android:textSize">26sp</item>
		<item name="android:background">@drawable/shape_np_pill_button</item>
	</style>

	<style name="NpcalcIconButtonStyle" parent="Widget.Material3.Button.IconButton">
		<item name="android:minWidth">64dp</item>
		<item name="android:minHeight">64dp</item>
		<item name="android:background">@drawable/shape_np_pill_button</item>
		<item name="android:tint">@color/npcolor_text_primary</item>
	</style>

	<style name="NpcalcToolbarStyle" parent="Widget.Material3.Toolbar">
		<item name="titleTextColor">@color/npcolor_text_primary</item>
		<item name="subtitleTextColor">@color/npcolor_text_secondary</item>
		<item name="android:background">@android:color/transparent</item>
	</style>
</resources>