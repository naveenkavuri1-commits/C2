<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:background="@color/npcolor_background_main">

	<TextView
		android:id="@+id/txtNpExpression"
		android:layout_width="0dp"
		android:layout_height="wrap_content"
		android:layout_marginStart="@dimen/npdim_display_padding_horizontal"
		android:layout_marginEnd="@dimen/npdim_display_padding_horizontal"
		android:layout_marginTop="@dimen/npdim_display_margin_top_large"
		android:text=""
		android:textColor="@color/npcolor_text_secondary"
		android:textSize="18sp"
		android:maxLines="1"
		android:ellipsize="end"
		app:layout_constrainedWidth="true"
		app:layout_constraintTop_toTopOf="parent"
		app:layout_constraintStart_toStartOf="parent"
		app:layout_constraintEnd_toEndOf="parent" />

	<TextView
		android:id="@+id/txtNpPrimary"
		android:layout_width="0dp"
		android:layout_height="wrap_content"
		android:layout_marginStart="@dimen/npdim_display_padding_horizontal"
		android:layout_marginEnd="@dimen/npdim_display_padding_horizontal"
		android:layout_marginTop="@dimen/npdim_display_margin_top_small"
		android:text="0"
		android:textColor="@color/npcolor_text_primary"
		android:textSize="@dimen/npdim_text_primary"
		android:maxLines="1"
		android:ellipsize="end"
		app:layout_constrainedWidth="true"
		app:layout_constraintTop_toBottomOf="@id/txtNpExpression"
		app:layout_constraintStart_toStartOf="parent"
		app:layout_constraintEnd_toEndOf="parent" />

	<androidx.gridlayout.widget.GridLayout
		android:id="@+id/gridNpKeys"
		android:layout_width="0dp"
		android:layout_height="0dp"
		android:layout_margin="@dimen/npdim_screen_padding"
		app:alignmentMode="alignMargins"
		app:columnCount="4"
		app:rowCount="5"
		app:layout_constraintDimensionRatio="4:5"
		app:layout_constraintVertical_bias="1.0"
		app:layout_constraintTop_toBottomOf="@id/txtNpPrimary"
		app:layout_constraintBottom_toBottomOf="parent"
		app:layout_constraintStart_toStartOf="parent"
		app:layout_constraintEnd_toEndOf="parent">

		<com.google.android.material.button.MaterialButton
			android:id="@+id/btnNpClear"
			style="@style/NpcalcPillButtonStyle"
			android:layout_width="0dp"
			android:layout_height="0dp"
			android:minWidth="64dp"
			android:minHeight="64dp"
			android:layout_margin="@dimen/npdim_key_margin"
			android:text="C"
			android:contentDescription="@string/npcalc_desc_clear"
			app:layout_columnWeight="1"
			app:layout_rowWeight="1" />

		<com.google.android.material.button.MaterialButton
			android:id="@+id/btnNpBackspace"
			style="@style/NpcalcPillButtonStyle"
			android:layout_width="0dp"
			android:layout_height="0dp"
			android:minWidth="64dp"
			android:minHeight="64dp"
			android:layout_margin="@dimen/npdim_key_margin"
			android:contentDescription="@string/npcalc_desc_backspace"
			app:icon="@drawable/np_ic_backspace"
			app:iconTint="@color/npcolor_text_primary"
			app:layout_columnWeight="1"
			app:layout_rowWeight="1" />

		<com.google.android.material.button.MaterialButton
			android:id="@+id/btnNpPercent"
			style="@style/NpcalcPillButtonStyle"
			android:layout_width="0dp"
			android:layout_height="0dp"
			android:minWidth="64dp"
			android:minHeight="64dp"
			android:layout_margin="8dp"
			android:text="%"
			android:contentDescription="@string/npcalc_desc_percent"
			android:background="@drawable/np_operator_button_bg"
			app:layout_columnWeight="1"
			app:layout_rowWeight="1" />

		<com.google.android.material.button.MaterialButton
			android:id="@+id/btnNpDivide"
			style="@style/NpcalcPillButtonStyle"
			android:layout_width="0dp"
			android:layout_height="0dp"
			android:minWidth="64dp"
			android:minHeight="64dp"
			android:layout_margin="@dimen/npdim_key_margin"
			android:text="÷"
			android:contentDescription="@string/npcalc_desc_divide"
			android:background="@drawable/np_operator_button_bg"
			app:layout_columnWeight="1"
			app:layout_rowWeight="1" />

		<com.google.android.material.button.MaterialButton
			android:id="@+id/btnNpDigit7"
			style="@style/NpcalcPillButtonStyle"
			android:layout_width="0dp"
			android:layout_height="0dp"
			android:minWidth="64dp"
			android:minHeight="64dp"
			android:layout_margin="@dimen/npdim_key_margin"
			android:text="7"
			app:layout_columnWeight="1"
			app:layout_rowWeight="1" />

		<com.google.android.material.button.MaterialButton
			android:id="@+id/btnNpDigit8"
			style="@style/NpcalcPillButtonStyle"
			android:layout_width="0dp"
			android:layout_height="0dp"
			android:minWidth="64dp"
			android:minHeight="64dp"
			android:layout_margin="@dimen/npdim_key_margin"
			android:text="8"
			app:layout_columnWeight="1"
			app:layout_rowWeight="1" />

		<com.google.android.material.button.MaterialButton
			android:id="@+id/btnNpDigit9"
			style="@style/NpcalcPillButtonStyle"
			android:layout_width="0dp"
			android:layout_height="0dp"
			android:minWidth="64dp"
			android:minHeight="64dp"
			android:layout_margin="@dimen/npdim_key_margin"
			android:text="9"
			app:layout_columnWeight="1"
			app:layout_rowWeight="1" />

		<com.google.android.material.button.MaterialButton
			android:id="@+id/btnNpMultiply"
			style="@style/NpcalcPillButtonStyle"
			android:layout_width="0dp"
			android:layout_height="0dp"
			android:minWidth="64dp"
			android:minHeight="64dp"
			android:layout_margin="@dimen/npdim_key_margin"
			android:text="×"
			android:contentDescription="@string/npcalc_desc_multiply"
			android:background="@drawable/np_operator_button_bg"
			app:layout_columnWeight="1"
			app:layout_rowWeight="1" />

		<com.google.android.material.button.MaterialButton
			android:id="@+id/btnNpDigit4"
			style="@style/NpcalcPillButtonStyle"
			android:layout_width="0dp"
			android:layout_height="0dp"
			android:minWidth="64dp"
			android:minHeight="64dp"
			android:layout_margin="@dimen/npdim_key_margin"
			android:text="4"
			app:layout_columnWeight="1"
			app:layout_rowWeight="1" />

		<com.google.android.material.button.MaterialButton
			android:id="@+id/btnNpDigit5"
			style="@style/NpcalcPillButtonStyle"
			android:layout_width="0dp"
			android:layout_height="0dp"
			android:minWidth="64dp"
			android:minHeight="64dp"
			android:layout_margin="@dimen/npdim_key_margin"
			android:text="5"
			app:layout_columnWeight="1"
			app:layout_rowWeight="1" />

		<com.google.android.material.button.MaterialButton
			android:id="@+id/btnNpDigit6"
			style="@style/NpcalcPillButtonStyle"
			android:layout_width="0dp"
			android:layout_height="0dp"
			android:minWidth="64dp"
			android:minHeight="64dp"
			android:layout_margin="@dimen/npdim_key_margin"
			android:text="6"
			app:layout_columnWeight="1"
			app:layout_rowWeight="1" />

		<com.google.android.material.button.MaterialButton
			android:id="@+id/btnNpMinus"
			style="@style/NpcalcPillButtonStyle"
			android:layout_width="0dp"
			android:layout_height="0dp"
			android:minWidth="64dp"
			android:minHeight="64dp"
			android:layout_margin="@dimen/npdim_key_margin"
			android:text="-"
			android:contentDescription="@string/npcalc_desc_minus"
			android:background="@drawable/np_operator_button_bg"
			app:layout_columnWeight="1"
			app:layout_rowWeight="1" />

		<com.google.android.material.button.MaterialButton
			android:id="@+id/btnNpDigit1"
			style="@style/NpcalcPillButtonStyle"
			android:layout_width="0dp"
			android:layout_height="0dp"
			android:minWidth="64dp"
			android:minHeight="64dp"
			android:layout_margin="@dimen/npdim_key_margin"
			android:text="1"
			app:layout_columnWeight="1"
			app:layout_rowWeight="1" />

		<com.google.android.material.button.MaterialButton
			android:id="@+id/btnNpDigit2"
			style="@style/NpcalcPillButtonStyle"
			android:layout_width="0dp"
			android:layout_height="0dp"
			android:minWidth="64dp"
			android:minHeight="64dp"
			android:layout_margin="@dimen/npdim_key_margin"
			android:text="2"
			app:layout_columnWeight="1"
			app:layout_rowWeight="1" />

		<com.google.android.material.button.MaterialButton
			android:id="@+id/btnNpDigit3"
			style="@style/NpcalcPillButtonStyle"
			android:layout_width="0dp"
			android:layout_height="0dp"
			android:minWidth="64dp"
			android:minHeight="64dp"
			android:layout_margin="@dimen/npdim_key_margin"
			android:text="3"
			app:layout_columnWeight="1"
			app:layout_rowWeight="1" />

		<com.google.android.material.button.MaterialButton
			android:id="@+id/btnNpPlus"
			style="@style/NpcalcPillButtonStyle"
			android:layout_width="0dp"
			android:layout_height="0dp"
			android:minWidth="64dp"
			android:minHeight="64dp"
			android:layout_margin="@dimen/npdim_key_margin"
			android:text="+"
			android:contentDescription="@string/npcalc_desc_plus"
			android:background="@drawable/np_operator_button_bg"
			app:layout_columnWeight="1"
			app:layout_rowWeight="1" />

		<com.google.android.material.button.MaterialButton
			android:id="@+id/btnNpSign"
			style="@style/NpcalcPillButtonStyle"
			android:layout_width="0dp"
			android:layout_height="0dp"
			android:minWidth="64dp"
			android:minHeight="64dp"
			android:layout_margin="@dimen/npdim_key_margin"
			android:text="±"
			android:contentDescription="@string/npcalc_desc_sign"
			android:background="@drawable/np_operator_button_bg"
			app:layout_columnWeight="1"
			app:layout_rowWeight="1" />

		<com.google.android.material.button.MaterialButton
			android:id="@+id/btnNpDigit0"
			style="@style/NpcalcPillButtonStyle"
			android:layout_width="0dp"
			android:layout_height="0dp"
			android:minWidth="64dp"
			android:minHeight="64dp"
			android:layout_margin="@dimen/npdim_key_margin"
			android:text="0"
			app:layout_columnSpan="2"
			app:layout_columnWeight="2"
			app:layout_rowWeight="1" />

		<com.google.android.material.button.MaterialButton
			android:id="@+id/btnNpDot"
			style="@style/NpcalcPillButtonStyle"
			android:layout_width="0dp"
			android:layout_height="0dp"
			android:minWidth="64dp"
			android:minHeight="64dp"
			android:layout_margin="@dimen/npdim_key_margin"
			android:text="."
			android:background="@drawable/np_operator_button_bg"
			app:layout_columnWeight="1"
			app:layout_rowWeight="1" />

		<com.google.android.material.button.MaterialButton
			android:id="@+id/btnNpEquals"
			style="@style/NpcalcPillButtonStyle"
			android:layout_width="0dp"
			android:layout_height="0dp"
			android:minWidth="64dp"
			android:minHeight="64dp"
			android:layout_margin="@dimen/npdim_key_margin"
			android:text="="
			android:contentDescription="@string/npcalc_desc_equals"
			android:background="@drawable/np_equal_button_bg"
			android:textColor="@color/npcolor_background_main"
			app:layout_columnWeight="1"
			app:layout_rowWeight="1" />

	</androidx.gridlayout.widget.GridLayout>

</androidx.constraintlayout.widget.ConstraintLayout>