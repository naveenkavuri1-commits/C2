<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:background="@color/npcolor_background_main">

	<com.google.android.material.appbar.MaterialToolbar
		android:id="@+id/toolbarNpHistory"
		android:layout_width="0dp"
		android:layout_height="wrap_content"
		android:layout_marginStart="@dimen/npdim_display_padding_horizontal"
		android:layout_marginEnd="@dimen/npdim_display_padding_horizontal"
		android:layout_marginTop="@dimen/npdim_display_margin_top_large"
		android:background="@android:color/transparent"
		android:titleTextColor="@color/npcolor_text_primary"
		app:layout_constrainedWidth="true"
		app:layout_constraintTop_toTopOf="parent"
		app:layout_constraintStart_toStartOf="parent"
		app:layout_constraintEnd_toEndOf="parent" />

	<com.google.android.material.button.MaterialButton
		android:id="@+id/btnNpClearHistory"
		style="@style/NpcalcPillButtonStyle"
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:text="Clear history"
		android:layout_marginStart="@dimen/npdim_display_padding_horizontal"
		android:layout_marginTop="8dp"
		app:layout_constraintTop_toBottomOf="@id/toolbarNpHistory"
		app:layout_constraintStart_toStartOf="parent" />

	<androidx.recyclerview.widget.RecyclerView
		android:id="@+id/listNpHistory"
		android:layout_width="0dp"
		android:layout_height="0dp"
		android:padding="@dimen/npdim_screen_padding"
		app:layout_constraintTop_toBottomOf="@id/btnNpClearHistory"
		app:layout_constraintBottom_toBottomOf="parent"
		app:layout_constraintStart_toStartOf="parent"
		app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>